# ═══════════════════════════════════════════════════════
#  Ace Tours & Transfers — Environment Variables
#  Copy this file to .env and fill in your values.
#  For a minimal, ready-to-paste skeleton with only the active variables,
#  copy .env.active.example instead.
#  On Render: Dashboard → the web service → Environment.
#
#  REQUIRED  the site won't start, or core features break, without it
#  RECOMMENDED  works without it, but a feature is degraded
#  OPTIONAL  only for the feature named
#
#  Values are read with dotenv in local development. Production (Render/Fly)
#  uses the platform's environment/secret store, not this file.
# ═══════════════════════════════════════════════════════

NODE_ENV=development
# production on Render

# ── App ──────────────────────────────────────────────
# REQUIRED. Must be the public https origin (used in emails, callbacks, CORS).
APP_URL=https://acetoursvanuatu.com
# Build-time copy for the browser bundle (canonical/OG/JSON-LD URLs).
VITE_APP_URL=https://acetoursvanuatu.com

# ── Database (REQUIRED) — Neon PostgreSQL ───────────
# Get from: https://console.neon.tech → Project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# TLS verification is ON by default. Only set DATABASE_SSL_CA when the runtime
# does not trust Neon's certificate (PEM; literal \n is accepted).
# DATABASE_SSL_CA=
# Emergency only — disables certificate validation for the database connection:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ── Sessions (REQUIRED) ─────────────────────────────
# At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Encryption keys ─────────────────────────────────
# REQUIRED: encrypts the bank gateway credentials saved in Admin → Payments.
# 32 random bytes, Base64. Generate with: openssl rand -base64 32
# Losing it means re-entering every gateway key in admin.
PAYMENT_CREDENTIALS_KEY=
# OPTIONAL/RECOMMENDED: encrypts TOTP (MFA) secrets. Falls back to
# PAYMENT_CREDENTIALS_KEY when empty. Use a separate key so rotating the payment
# key does not invalidate MFA enrolments.
# DATA_ENCRYPTION_KEY=

# ── Business contact (used in emails) ───────────────
BUSINESS_PHONE=+678 7114045
WHATSAPP_NUMBER=6787114045
BUSINESS_EMAIL=acetoursvanuatu@outlook.com
# OPTIONAL: "leave a review" link in post-tour emails
# GOOGLE_REVIEW_URL=

# ── Bank transfer details (fallback only) ───────────
# Set these in Admin → Settings → Payments: that is the one source for the
# bank-transfer email and the booking page. These env values are used only for
# a field left empty in admin.
# BANK_NAME=
# BANK_ACCOUNT_NAME=Ace Tours & Transfers
# BANK_ACCOUNT_NUMBER=

# ── Cloudinary (REQUIRED for image uploads) ─────────
# Get from: https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── Email (REQUIRED for booking emails) ─────────────
# Gmail: use an App Password from https://myaccount.google.com/apppasswords
ADMIN_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@acetoursvanuatu.com

# ── Payments ────────────────────────────────────────
# Master switch for new payments (false = all new payments refused).
PAYMENTS_ENABLED=true
# manual | stripe | anz | bsp | bred | nbv
PAYMENTS_DEFAULT_PROVIDER=manual

# Manual/offline methods: on unless set to false.
PAYMENTS_MANUAL_ENABLED=true
MANUAL_PAYMENT_BANK_TRANSFER=true
MANUAL_PAYMENT_CASH_ON_DELIVERY=true

# Card payments. Before switching a bank on in Admin → Payments set BOTH:
#   1. DDD_DISABLE_CARD=false   (otherwise card payments are refused)
#   2. that bank's ENABLED switch=true
# The gateway must also be active in Admin → Payments.
DDD_DISABLE_CARD=true
PAYMENTS_ANZ_ENABLED=false    # ANZ eGate (MPGS)
PAYMENTS_BSP_ENABLED=false    # BSP (MPGS)
PAYMENTS_NBV_ENABLED=false    # National Bank of Vanuatu (MPGS)
PAYMENTS_BRED_ENABLED=false   # BRED (Lyra PayZen)
# Bank credentials are NOT set here: enter them in Admin → Payments.
# Gateway visibility is controlled by Admin → Payments + feature flags. The old
# PAYMENTS_<BANK>_VISIBLE flags are not read (see the deprecated block below).

# Stripe (kept off: not available to Vanuatu merchants)
PAYMENTS_STRIPE_ENABLED=false
PAYMENTS_STRIPE_VISIBLE=false
STRIPE_ENABLED=false
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=   # required in production if Stripe is enabled

# ── Emergency stops (OPTIONAL — add only when needed) ─
# These block NEW payments/bookings only; payments already started still
# confirm. See docs/KILL_SWITCH_POLICY.md. To stop a gateway's callbacks, switch
# the gateway off in Admin → Payments as well.
# GLOBAL_PAYMENTS_PAUSE=true       # all new payments
# PAUSE_CARD_PAYMENTS=true         # new card payments
# PAYMENTS_EXTERNAL_DISABLED=true  # everything except bank transfer and cash
# PAUSE_BANK_TRANSFER=true         # new bank-transfer payments
# NEW_BOOKINGS_PAUSE=true          # new bookings

# ── Tax ─────────────────────────────────────────────
# VAT_RATE=0.15        # default 15%; VAT_RATE wins over DDD_VAT_RATE
# DDD_VAT_RATE=0.15    # compatibility fallback

# ── Monitoring (OPTIONAL) ───────────────────────────
# Sentry: https://sentry.io → Project → Settings → DSN
SENTRY_DSN=
# BetterStack: https://betterstack.com → Monitors
BETTERSTACK_API_KEY=
BETTERSTACK_MONITOR_ID=
# LOG_LEVEL=info
# LOG_API_BODIES=true   # debug only: logs scrubbed request bodies (contains PII otherwise)

# ── SMS (OPTIONAL) ──────────────────────────────────
# Provider: 'console' (no SMS sent) | 'android_gateway' | 'twilio'
SMS_PROVIDER=console
# SMS_ADMIN_PHONE=+678XXXXXXX     # receives admin alerts
# android_gateway (SMS Gateway for Android):
# SMS_CLOUD_URL=https://api.sms-gate.app
# SMS_CLOUD_LOGIN=
# SMS_CLOUD_PASSWORD=
# twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Third-party widgets (OPTIONAL) ──────────────────
# VITE_* values are baked into the client bundle at build time.
VITE_TRUSTPILOT_BU_ID=
VITE_TRUSTPILOT_URL=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Google Maps Embed API key (tour/transfer detail pages)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_MAPS_EMBED_KEY=

# ── Feature toggles / SEO ───────────────────────────
VITE_COMING_SOON=false
# FORCE_PRICING_ENGINE=false          # feature-flag override, normally leave unset
# SITEMAP_STATIC_LASTMOD=2026-11-08   # optional; only set from the deploy pipeline

# ── Set automatically — do not add these ────────────
# RENDER_GIT_COMMIT        Render sets it; shown at /api/health
# PORT, PRERENDER_*        set by the Docker image/startup script
# VITE_APP_URL is also passed as a Docker build ARG (see Dockerfile).
#
# On Render, VITE_* values have NO effect unless they are passed as build ARGs;
# the Dockerfile declares VITE_APP_URL, VITE_COMING_SOON,
# VITE_GOOGLE_MAPS_EMBED_KEY, VITE_TRUSTPILOT_BU_ID and VITE_TRUSTPILOT_URL.

# ── Deprecated / not read — safe to delete from .env ─
# These appear in older templates but no application code reads them:
#   ANZ_API_KEY, ANZ_API_SECRET, ANZ_MERCHANT_ID
#   BSP_API_KEY, BSP_API_SECRET, BSP_MERCHANT_ID
#   BRED_API_KEY, BRED_API_SECRET, BRED_MERCHANT_ID
#     (bank credentials live in Admin → Payments, encrypted in the database)
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, AWS_BUCKET_NAME,
#   AWS_S3_ENDPOINT_URL
#   DB_HOST, DB_NAME, DB_PASSWORD, DB_PORT, DB_USER   (use DATABASE_URL)
#   COOKIE_EXPIRES_IN, COOKIE_HTTP_ONLY, COOKIE_REFRESH_EXPIRES_IN,
#   COOKIE_SAME_SITE, COOKIE_SECURE
#   JWT_EXPIRES_IN, JWT_REFRESH_EXPIRES_IN, JWT_SECRET   (server-side sessions)
#   MAILTRAP_AUTH_TYPE, MAILTRAP_HOST, MAILTRAP_PASS, MAILTRAP_PORT,
#   MAILTRAP_SECURE, MAILTRAP_TLS_REJECT_UNAUTHORIZED, MAILTRAP_USER
#   PAGINATION_LIMIT, PAGINATION_PAGE
#   REDIS_URL
#   PAYMENT_GATEWAY_URL
#   PAYMENTS_ANZ_VISIBLE, PAYMENTS_BSP_VISIBLE, PAYMENTS_NBV_VISIBLE,
#   PAYMENTS_BRED_VISIBLE, PAYMENTS_MANUAL_VISIBLE
#   PAYMENTS_STRIPE_MODE
#   VITE_CLOUDINARY_CLOUD_NAME
#   SMS_ENABLED, SMS_GATEWAY_URL, SMS_GATEWAY_USER, SMS_GATEWAY_PASS,
#   SMS_FROM_NAME, ANDROID_GATEWAY_URL, ANDROID_GATEWAY_API_KEY
#   DDD_SHARPENING_ACTIVE   (read into config but not enforced)
