# ═══════════════════════════════════════════════════════
#  Ace Tours & Transfers — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════

NODE_ENV=development

# ── App ─────────────────────────────────────────────
APP_URL=https://acetoursvanuatu.com
BUSINESS_PHONE=+678 7114045
WHATSAPP_NUMBER=6787114045

# ── Database (Neon PostgreSQL) ──────────────────────
# Get from: https://console.neon.tech → Project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Session & Auth ──────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_REFRESH_EXPIRES_IN=30d

# ── Cookie Settings ─────────────────────────────────
COOKIE_EXPIRES_IN=90d
COOKIE_REFRESH_EXPIRES_IN=30d
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false   # Set to true in production

# ── Cloudinary (Image Storage) ──────────────────────
# Get from: https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
VITE_CLOUDINARY_CLOUD_NAME=   # Same as CLOUDINARY_CLOUD_NAME

# ── Email (SMTP) ───────────────────────────────────
# Gmail: use App Password from https://myaccount.google.com/apppasswords
ADMIN_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@acetoursvanuatu.com

# Mailtrap (dev/staging email testing — leave blank in production)
MAILTRAP_USER=
MAILTRAP_PASS=
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_SECURE=false
MAILTRAP_AUTH_TYPE=login
MAILTRAP_TLS_REJECT_UNAUTHORIZED=false

# ── Payments ────────────────────────────────────────
PAYMENTS_DEFAULT_PROVIDER=manual
PAYMENTS_EXTERNAL_DISABLED=true

PAYMENTS_MANUAL_ENABLED=true
PAYMENTS_MANUAL_VISIBLE=true

PAYMENTS_STRIPE_ENABLED=false
PAYMENTS_STRIPE_VISIBLE=false
PAYMENTS_STRIPE_MODE=sandbox
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

PAYMENTS_ANZ_ENABLED=false
PAYMENTS_ANZ_VISIBLE=false
ANZ_MERCHANT_ID=
ANZ_API_KEY=
ANZ_API_SECRET=

PAYMENTS_BSP_ENABLED=false
PAYMENTS_BSP_VISIBLE=false
BSP_MERCHANT_ID=
BSP_API_KEY=
BSP_API_SECRET=

PAYMENTS_BRED_ENABLED=false
PAYMENTS_BRED_VISIBLE=false
BRED_MERCHANT_ID=
BRED_API_KEY=
BRED_API_SECRET=

# ── Monitoring ──────────────────────────────────────
# Sentry: https://sentry.io → Project → Settings → DSN
SENTRY_DSN=

# BetterStack: https://betterstack.com → Monitors
BETTERSTACK_API_KEY=
BETTERSTACK_MONITOR_ID=

# ── SMS (Optional) ─────────────────────────────────
# Provider: 'console' | 'android_gateway' | 'twilio'
SMS_PROVIDER=console
SMS_ENABLED=
SMS_FROM_NAME=AceTours
# SMS_ADMIN_PHONE=+678XXXXXXX
# SMS_CLOUD_URL=https://api.sms-gate.app
# SMS_CLOUD_LOGIN=
# SMS_CLOUD_PASSWORD=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Third-Party Widgets (Optional) ─────────────────
VITE_TRUSTPILOT_BU_ID=
VITE_TRUSTPILOT_URL=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Google Maps Embed API key (used on tour/transfer detail pages)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_MAPS_EMBED_KEY=

# ── Feature Toggles ────────────────────────────────
VITE_COMING_SOON=false

# ── Pagination ──────────────────────────────────────
PAGINATION_LIMIT=100
PAGINATION_PAGE=100000
