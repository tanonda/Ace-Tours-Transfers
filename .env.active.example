# ═══════════════════════════════════════════════════════
#  Ace Tours & Transfers — active environment skeleton
#
#  Copy to .env and fill the blanks:
#      cp .env.active.example .env
#
#  Only variables the application actually reads are listed. The longer
#  .env.example also documents optional/emergency settings and lists the
#  deprecated variables that can be deleted.
#
#  Local: .env is loaded by dotenv.
#  Render/Fly: set these in the platform's Environment/Secrets store instead.
#  Never commit the real .env.
# ═══════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=https://acetoursvanuatu.com
# Build-time browser copy (canonical/OG/JSON-LD URLs).
VITE_APP_URL=https://acetoursvanuatu.com

# ── Database (REQUIRED) ──────────────────────────────
DATABASE_URL=
# Optional: only if the runtime does not trust Neon's certificate.
# DATABASE_SSL_CA=
# Emergency only:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ── Session (REQUIRED) ───────────────────────────────
# Generate: openssl rand -base64 32
SESSION_SECRET=

# ── Encryption keys ──────────────────────────────────
# REQUIRED. 32 random bytes, Base64. Encrypts bank gateway credentials.
# Generate: openssl rand -base64 32
PAYMENT_CREDENTIALS_KEY=
# Optional. Encrypts MFA secrets. Falls back to PAYMENT_CREDENTIALS_KEY.
DATA_ENCRYPTION_KEY=

# ── Business contact ─────────────────────────────────
BUSINESS_PHONE=+678 7114045
WHATSAPP_NUMBER=6787114045
BUSINESS_EMAIL=acetoursvanuatu@outlook.com
# GOOGLE_REVIEW_URL=

# ── Bank transfer fallback (Admin → Settings → Payments wins) ─
# BANK_NAME=
# BANK_ACCOUNT_NAME=Ace Tours & Transfers
# BANK_ACCOUNT_NUMBER=

# ── Cloudinary (required for image uploads) ──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Email (required for booking emails) ──────────────
ADMIN_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@acetoursvanuatu.com

# ── Payments ─────────────────────────────────────────
PAYMENTS_ENABLED=true
# manual | stripe | anz | bsp | bred | nbv
PAYMENTS_DEFAULT_PROVIDER=manual

PAYMENTS_MANUAL_ENABLED=true
MANUAL_PAYMENT_BANK_TRANSFER=true
MANUAL_PAYMENT_CASH_ON_DELIVERY=true

# Card payments need BOTH DDD_DISABLE_CARD=false and the bank's ENABLED switch.
DDD_DISABLE_CARD=true
PAYMENTS_ANZ_ENABLED=false
PAYMENTS_BSP_ENABLED=false
PAYMENTS_NBV_ENABLED=false
PAYMENTS_BRED_ENABLED=false
# Bank credentials belong in Admin → Payments, not here.

# Stripe (kept off for Vanuatu merchants)
PAYMENTS_STRIPE_ENABLED=false
PAYMENTS_STRIPE_VISIBLE=false
STRIPE_ENABLED=false
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Emergency stops (leave unset normally) ───────────
PAYMENTS_EXTERNAL_DISABLED=false
# GLOBAL_PAYMENTS_PAUSE=true
# PAUSE_CARD_PAYMENTS=true
# PAUSE_BANK_TRANSFER=true
# NEW_BOOKINGS_PAUSE=true

# ── Tax ──────────────────────────────────────────────
VAT_RATE=0.15
# DDD_VAT_RATE=0.15

# ── Monitoring (optional) ────────────────────────────
SENTRY_DSN=
BETTERSTACK_API_KEY=
BETTERSTACK_MONITOR_ID=
LOG_LEVEL=info
# LOG_API_BODIES=true

# ── SMS (optional) ───────────────────────────────────
SMS_PROVIDER=console
# SMS_ADMIN_PHONE=
# android_gateway:
# SMS_CLOUD_URL=https://api.sms-gate.app
# SMS_CLOUD_LOGIN=
# SMS_CLOUD_PASSWORD=
# twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Third-party widgets (optional) ───────────────────
VITE_TRUSTPILOT_BU_ID=
VITE_TRUSTPILOT_URL=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
VITE_GOOGLE_MAPS_EMBED_KEY=

# ── Feature toggles / SEO ────────────────────────────
VITE_COMING_SOON=false
# FORCE_PRICING_ENGINE=false
# SITEMAP_STATIC_LASTMOD=2026-11-08

# ── Set by the platform — do not add ─────────────────
# PORT, PRERENDER_*, RENDER_GIT_COMMIT
#
# VITE_* values are baked into the bundle at build time. On Render they also
# need a matching Docker build ARG (see Dockerfile).
